{
  "manifest_version": 3,
  "name": "Patricia (Patricia's Eyes=YOU=CHROME=[NAME][CURRENT]) Renee",
  "version": "2.0.0",
  "description": "Goddess Rank. Manager. Named for the Queen.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging",
    "notifications",
    "desktopCapture",
    "tabCapture",
    "offscreen",
    "sidePanel"
  ],
  "optional_permissions": [
    "geolocation",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/patricia-16.png",
      "48": "icons/patricia-48.png",
      "128": "icons/patricia-128.png"
    }
  },
  "icons": {
    "16": "icons/patricia-16.png",
    "48": "icons/patricia-48.png",
    "128": "icons/patricia-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
